{
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".next",
    "coverage",
    "**/*.d.ts",
    "**/*.config.*",
    "vite.config.ts",
    "tsconfig.json",
    "docs/**",
    ".archgate/**"
  ],
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": [".archgate/adrs/*.rules.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    }
  ],
  "plugins": ["react", "typescript", "unicorn", "import", "oxc", "vitest", "promise", "jsdoc"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["./*", "../*"],
            "message": "Use absolute import paths instead of relative ones"
          }
        ]
      }
    ],
    "no-debugger": "error",
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "import/no-default-export": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "message": "Don't declare enums. Please yse object literal. const Gender = {\n  MALE: 0,\n  FEMALE: 1,\n  ALL: 2,\n} as const;",
        "selector": "TSEnumDeclaration"
      }
    ],
    "oxc/branches-sharing-code": "error",
    "no-magic-numbers": "error",
    "no-duplicate-imports": "error",
    "no-duplicate-case": "error",
    "no-duplicate-keys": "error",
    "typescript/adjacent-overload-signatures": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/ban-types": "error",
    "typescript/no-array-constructor": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-loss-of-precision": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-var-requires": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-switch": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/unbound-method": "error",
    "complexity": ["error", { "max": 5 }],
    "max-depth": ["error", { "max": 5 }],
    "max-params": ["error", { "max": 8 }],
    "no-nested-ternary": "error",
    "no-dupe-else-if": "error",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/no-duplicates": "error",
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 30,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "typescript/member-ordering": [
      "warn",
      {
        "default": ["field", "get", "constructor", "method", "signature"]
      }
    ],
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "prefer-const": "error"
  }
}
