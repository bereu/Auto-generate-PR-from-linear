# GitHub Configuration
# Personal Access Token (PAT) with repository access
GITHUB_TOKEN=your_github_token_here

# Linear Configuration
# API key for accessing Linear workspace
LINEAR_API_KEY=your_linear_api_key_here
# Secret key used to verify webhook payloads from Linear
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret_here
# Linear MCP server endpoint (required for triage agent)
LINEAR_MCP_URL=http://localhost:3001  # TODO(task1): confirm MCP endpoint
# Linear MCP server token or API key (required for triage agent)
LINEAR_MCP_TOKEN=your_linear_mcp_token_here

# LLM Provider Configuration
# API key for Anthropic Claude models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Workspace Configuration
# Path to the local workspace directory
WORKSPACE=/path/to/your/workspace

# Slack Integration Configuration
# Slack Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=your_slack_bot_token_here
# Slack Signing Secret for verifying request signatures
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
# Slack MCP server endpoint (Optional; read/search only)
# TODO(task1): confirm Slack MCP endpoint after admin approval for mcp:connect scope
SLACK_MCP_URL=http://localhost:3002
# Slack MCP server user OAuth token (Optional; user identity, not bot)
SLACK_MCP_TOKEN=xoxp-your_slack_user_oauth_token_here

# Langfuse Observability Configuration (Optional)
LANGFUSE_SECRET_KEY="your_langfuse_secret_key_here"
LANGFUSE_PUBLIC_KEY="your_langfuse_public_key_here"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Rollbar Error Reporting Configuration (Optional)
# Access token for Rollbar error monitoring service
ROLLBAR_ACCESS_TOKEN=your_rollbar_access_token_here
# Environment name for Rollbar (e.g., development, staging, production)
ROLLBAR_ENVIRONMENT=development
# Code version for Rollbar release tracking
ROLLBAR_CODE_VERSION=your_code_version_here
